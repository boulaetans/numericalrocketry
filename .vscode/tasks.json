{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Flight Comparison GIF",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "animate_flight_comparison.py",
        "--fps",
        "20",
        "--output",
        "assets/flight_comparison.gif"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
