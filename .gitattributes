# The interactive comparison charts are self-contained HTML files with the
# full plotly.js library (a few MB of minified JavaScript) bundled directly
# into a <script> tag, so GitHub's language detector (Linguist) counts that
# bundle as source and badly skews the repo's language breakdown. Both are
# generated by plot_flight_comparison_interactive.py / legacy_1d_simulator.py,
# not hand-written, so linguist-generated excludes them from language stats
# and collapses them by default in diffs.
assets/flight_comparison_interactive.html linguist-generated=true
legacy/comparison_interactive.html linguist-generated=true
